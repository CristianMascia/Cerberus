# Cerberus — profilo per l'HPC UniNA (cluster unina-hpc).
#
# Partizione `ingnormal`: nodi r7625ing-gpu[01-08], 2x NVIDIA H100 NVL (94 GB,
# sm_90, nessun NVLink tra le due GPU), 256 CPU, 773 GB RAM. Apptainer 1.4,
# home su Lustre (/lustre/home/$USER), nessun sistema di moduli.
#
# Uso (sul login node e dentro gli job, prima di cerberus download/up/batch):
#   source profiles/unina-h100.env
#
# Nel models.conf: [allocation] gpus_per_node = 2, vram_gib = 92
# (vedi test/demo/unina_h100/models.conf). Guida: docs/hpc_unina_h100.md

# Immagine con llama-server dentro, compilata per sm_90 (docs/hpc_unina_h100.md, punto 2):
#   CUDA_ARCH=90 cerberus/containers/build_llamacpp_local.sh llamacpp_local.def ~/containers/llamacpp_h100.sif
export CERBERUS_IMAGE="${CERBERUS_IMAGE:-$HOME/containers/llamacpp_h100.sif}"

# Immagine vLLM per i modelli con backend = "vllm" (docs/hpc_unina_h100.md, punto 5):
#   apptainer pull ~/containers/vllm-0.32.0.sif docker://vllm/vllm-openai:v0.32.0
export CERBERUS_VLLM_IMAGE="${CERBERUS_VLLM_IMAGE:-$HOME/containers/vllm-0.32.0.sif}"

# Cache HF: la home è già su Lustre (condivisa tra login e nodi, senza quota).
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
# Token HF: salvato una volta con `hf auth login` in $HF_HOME/token (permessi 600).
# huggingface_hub lo legge da lì; la stima VRAM dei GGUF vuole HF_TOKEN.
if [ -z "${HF_TOKEN:-}" ] && [ -r "$HF_HOME/token" ]; then
    export HF_TOKEN="$(cat "$HF_HOME/token")"
fi

# Thread CPU per server. La QOS di ingnormal concede al massimo 10 CPU per job
# (e 4 GPU): con tutti i layer su GPU a llama-server ne bastano pochi.
export CERBERUS_THREADS="${CERBERUS_THREADS:-4}"
export CERBERUS_THREADS_HTTP="${CERBERUS_THREADS_HTTP:-2}"

# Cache e tmp di Apptainer fuori da /tmp (70 GB condivisi sul disco di sistema).
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$HOME/.apptainer/cache}"

